# Base de datos PostgreSQL
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_secure_postgres_password
POSTGRES_DB=your_database_name

# Configuración de Grafana
GRAFANA_DB_USER=your_grafana_user
GRAFANA_DB_PASSWORD=your_secure_grafana_password
GRAFANA_DB_NAME=your_grafana_database

# Configuración de Traefik/Dominio
GRAFANA_DOMAIN=your.domain.com
TRAEFIK_CERT_RESOLVER=letsencrypt

# Puertos (opcional, para facilitar cambios)
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
LOKI_PORT=3100
TEMPO_PORT=3200
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
OTEL_METRICS_PORT=8889
